{
  "version": 2,
  "rewrites": [
    { "source": "/api/admin/verify", "destination": "/api/admin/verify" },
    { "source": "/api/contact/:id*", "destination": "/api/contact" },
    { "source": "/api/contact", "destination": "/api/contact" },
    { "source": "/api/portfolio-data", "destination": "/api/portfolio-data" },
    { "source": "/api/upload-image", "destination": "/api/upload-image" },
    { "source": "/images/:path*", "destination": "/images/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
